# Environment variables for Chiku Assistant

# Server
ENV=development
PORT=8000
LOG_LEVEL=info

# Ollama LLM Backend
OLLAMA_BASE_URL=http://localhost:11434

# Speaker Authentication (Phase 2)
SPEAKER_AUTH_ENABLED=false

# Optional: Model paths (if using custom models)
# WHISPER_MODEL_PATH=/path/to/whisper/model
# TTS_MODEL_PATH=/path/to/tts/model
